# Fixed, non-sensitive placeholder values for the isolated e2e compose stack.
# Unlike docker-data/secret.env (gitignored, real dev secrets), this file is
# committed: every value here is throwaway and only ever used against a
# fresh, disposable e2e database/container set. See tests/e2e/conftest.py.
POSTGRES_PASSWORD=e2e_dummy_password
POSTGRES_USER=buoy_retriever_e2e
POSTGRES_NAME=buoy_retriever_e2e
POSTGRES_HOST=db
BACKEND_SECRET_KEY=e2e-dummy-django-secret-key-not-for-production
BACKEND_API_KEY=br_e2e_fake
HOHONU_API_KEY=FAKE
HOHONU_TIMEOUT=30
