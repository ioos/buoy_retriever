{
  "name": "buoy_retriever",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  // Docker-outside-of-docker: compose bind mounts (./backend, ./docker-data, ...) are resolved
  // by the compose client inside this container but executed by the HOST daemon, so the
  // in-container workspace path must equal the host path.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "vscode",
  "mounts": [
    // Named volumes over the heavy env dirs: native-speed installs on macOS.
    // Compose services never read these host dirs (they mask them with anonymous volumes).
    "source=buoy-retriever-backend-pixi,target=${containerWorkspaceFolder}/backend/.pixi,type=volume",
    "source=buoy-retriever-dagster-pixi,target=${containerWorkspaceFolder}/pipeline/_dagster/.pixi,type=volume",
    "source=buoy-retriever-aveva-pixi,target=${containerWorkspaceFolder}/pipeline/aveva/.pixi,type=volume",
    "source=buoy-retriever-hohonu-pixi,target=${containerWorkspaceFolder}/pipeline/hohonu/.pixi,type=volume",
    "source=buoy-retriever-s3ts-pixi,target=${containerWorkspaceFolder}/pipeline/s3_timeseries/.pixi,type=volume",
    "source=buoy-retriever-common-venv,target=${containerWorkspaceFolder}/common/.venv,type=volume",
    "source=buoy-retriever-frontend-node-modules,target=${containerWorkspaceFolder}/frontend/node_modules,type=volume",
    "source=buoy-retriever-home-cache,target=/home/vscode/.cache,type=volume",
    // Carry host Claude Code auth/settings/memory into the container
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind"
  ],
  "forwardPorts": [8080, 3000, 3002, 8969, 5432, 5433],
  "portsAttributes": {
    "8080": { "label": "backend (Django)" },
    "3000": { "label": "frontend (Next.js)" },
    "3002": { "label": "Dagster UI" },
    "8969": { "label": "Spotlight" },
    "5432": { "label": "postgres" },
    "5433": { "label": "dagster postgres" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "biomejs.biome",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.pixi/envs/dev/bin/python",
        "python.terminal.activateEnvironment": false,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
        "[json]": { "editor.defaultFormatter": "biomejs.biome" }
      }
    }
  }
}
